rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ============ Helper functions ============ */

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin list is optional — a missing config/admin doc just means "no admin".
    function isAdmin() {
      let ref = /databases/$(database)/documents/config/admin;
      return isSignedIn()
        && exists(ref)
        && 'emails' in get(ref).data
        && request.auth.token.email in get(ref).data.emails;
    }

    // Doc keyed by the lowercase email of the signed-in user.
    function allowedRef() {
      return /databases/$(database)/documents/allowedUsers/$(request.auth.token.email);
    }

    function isAllowedUser() {
      return isSignedIn() && exists(allowedRef());
    }

    // Teachers added before the role feature (or via bulk import without a
    // role) have NO "role" field. Accessing it directly would raise a rule
    // evaluation error and silently deny every write, so treat it as "".
    function role() {
      let docData = get(allowedRef()).data;
      return 'role' in docData && docData.role is string ? docData.role : "";
    }

    // A non-admin point award may only ever touch the merits / uniformPoints /
    // uniformDay fields — no renaming, house/class edits, email swaps, or field
    // deletions. uniformDay is the once-a-day uniform marker (see below).
    function isOnlyPointChanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["merits", "uniformPoints", "uniformDay"]);
    }

    // Defensive numeric read: students created before the uniform-points
    // feature exist may not carry a merits / uniformPoints field. Because the
    // rules language raises an error when a map key is missing, treat a missing
    // (or non-numeric) field as 0 instead of letting every award be denied.
    function fieldNum(docData, field) {
      return field in docData && docData[field] is number
        ? docData[field] : 0;
    }

    function awardDelta(field) {
      return fieldNum(request.resource.data, field) - fieldNum(resource.data, field);
    }

    // Is this update a *granting* of uniform points (net increase)?
    function isUniformAwardChange() {
      return awardDelta("uniformPoints") > 0;
    }

    // Uniform points may only be awarded during the window. This MUST stay in
    // sync with the UNIFORM_WINDOW_* constants / bkkClock() in app.js (the rules
    // language can't import the JS file). request.time.toMillis() is the UTC
    // epoch; add +7h (Bangkok) and derive wall-clock minute + weekday with pure
    // integer arithmetic — the rules Date type exposes NO getUTCDay/getUTCHours
    // style getters, so calendar access is done via epoch modulo math. The epoch
    // (1970-01-01) was a Thursday, hence the +4 offset below (0=Sun..6=Sat).
    // Award days are Mon(1), Tue(2), Wed(3) and Fri(5) — Thursday(4) excluded.
    function isUniformAwardWindow() {
      let ms = request.time.toMillis();
      let mins = (ms - ms % 60000) / 60000;      // whole UTC minutes since epoch
      let bkkTotalMin = mins + 420;              // Bangkok = UTC + 7h
      let bkkMin = bkkTotalMin % 1440;           // Bangkok minute-of-day
      let rem = bkkTotalMin % 10080;             // 1440*7 -> weekday residue
      let daysComp = (rem - rem % 1440) / 1440;  // 0..6 (1970-01-01 == Thursday)
      let wd = (4 + daysComp) % 7;               // 1..5 = Mon..Fri
      return (wd == 1 || wd == 2 || wd == 3 || wd == 5) // Mon/Tue/Wed/Fri only
          && bkkMin >= 420     // 07:00 Bangkok
          && bkkMin < 450;     // 07:30 Bangkok (exclusive)
    }

    // Read the once-a-day marker defensively: a missing / non-integer field
    // yields -1, which can never equal today's day number.
    function uniformDayOf(docData) {
      return 'uniformDay' in docData && docData.uniformDay is int
        ? docData.uniformDay : -1;
    }

    // Bangkok calendar day number (whole days since the Unix epoch, UTC+7).
    // Must stay in sync with bkkDayNumber() in app.js. request.time.toMillis()
    // is UTC epoch ms; shifting +7h and truncating to whole days yields the
    // Bangkok day, so the comparison stays correct across the 00:00 boundary.
    function todayBkkDay() {
      let ms = request.time.toMillis() + 25200000;  // +7h => Bangkok time
      return (ms - ms % 86400000) / 86400000;
    }

    // Granting uniform points is allowed only when ALL of the following hold:
    //   1. the awarding window is open, AND
    //   2. the student has NOT already received a uniform award today
    //      (resource.data.uniformDay != today), AND
    //   3. the write stamps uniformDay with today's Bangkok day number.
    // The stamp makes "max 1 uniform award per student per day" enforceable at
    // the server: a second award attempt the same day violates condition 2 even
    // if two clients race. All other updates (behaviour points, uniform
    // removals, admin resets to zero) are unaffected.
    function isUniformAwardAllowed() {
      // Non-granting updates are always allowed; only *granting* uniform points
      // must satisfy the window check plus the once-per-day marker transition.
      return !isUniformAwardChange()
          || (isUniformAwardWindow()
              && uniformDayOf(resource.data) != todayBkkDay()
              && uniformDayOf(request.resource.data) == todayBkkDay());
    }

    // Regular teachers may award a single point (+1) on one of the two axes.
    function isTeacherAward() {
      return isOnlyPointChanged() && (
        (awardDelta("merits") == 1 && awardDelta("uniformPoints") == 0)
        || (awardDelta("uniformPoints") == 1 && awardDelta("merits") == 0)
      );
    }

    // House leaders (LH) may award between 1 and 25 points on one axis.
    function isLHUpTo25Award() {
      return isOnlyPointChanged() && (
        (awardDelta("merits") >= 1 && awardDelta("merits") <= 25 && awardDelta("uniformPoints") == 0)
        || (awardDelta("uniformPoints") >= 1 && awardDelta("uniformPoints") <= 25 && awardDelta("merits") == 0)
      );
    }

    // The administering user must be granted the award being applied — and
    // uniform-point awards are additionally restricted to the weekday window.
    function isAwardAuthorized() {
      return isUniformAwardAllowed() && (
            isAdmin()
         || (isAllowedUser() && role() == "LH" && isLHUpTo25Award())
         || (isAllowedUser() && isTeacherAward())
      );
    }

    // The log "change" recorded must match the caller's awarding rights.
    // Read the field defensively so a malformed log never errors out the rule.
    function isTeacherLog() {
      return fieldNum(request.resource.data, "change") == 1;
    }

    function isLHLog() {
      let chg = fieldNum(request.resource.data, "change");
      return chg >= 1
          && chg <= 25;
    }

    // A uniform-point log entry (positive change) is only allowed inside the
    // awarding window; non-uniform entries and resets-to-zero are unaffected.
    function isUniformLogAllowed() {
      let logType = 'type' in request.resource.data ? request.resource.data.type : "";
      return logType != "uniform"
          || fieldNum(request.resource.data, "change") <= 0
          || isUniformAwardWindow();
    }

    function isLogAuthorized() {
      return isUniformLogAllowed() && (
            isAdmin()
         || (isAllowedUser() && role() == "LH" && isLHLog())
         || (isAllowedUser() && isTeacherLog())
      );
    }

    /* ============ Rules ============ */

    // Admin list
    match /config/admin {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Authorized teachers — self-read for the current user, admin manage only
    match /allowedUsers/{email} {
      allow read: if isSignedIn() && (isAdmin() || email == request.auth.token.email);
      allow create, update, delete: if isAdmin();
    }

    // Students — everyone signed in may view; only admins create/delete;
    // point awards are granted by admin, teacher (+1), or house leader (up to 25).
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAwardAuthorized();
    }

    // Point log — the awarding user logs their own entry; only admins edit/delete.
    match /meritLog/{logId} {
      allow read: if isSignedIn();
      allow create: if isLogAuthorized();
      allow update, delete: if isAdmin();
    }
  }
}